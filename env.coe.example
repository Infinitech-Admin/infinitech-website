# --- Laravel API base URL ---
LARAVEL_API_URL=http://localhost:8000

# --- Certificate numbering (lib/coe/certificate-number.ts) ---
# Replaces the old Laravel config/coe.php certificate_prefix / certificate_start.
COE_CERTIFICATE_PREFIX=CE
COE_CERTIFICATE_START=50
# Zero-pad width for the numeric part, e.g. 4 -> CE-0050
COE_CERTIFICATE_PAD_WIDTH=4

# --- Default signatory (lib/coe/certificate-number.ts) ---
# Used as a fallback in route.ts POST when the request body doesn't include
# signatory_name/signatory_title. Replaces config/coe.php signatory_name/title.
COE_DEFAULT_SIGNATORY_NAME=
COE_DEFAULT_SIGNATORY_TITLE=

# --- Document generator display fields (lib/coe/generate-coe-docx.ts) ---
COE_COMPANY_NAME=INFINITECH ADVERTISING CORPORATION
COE_FOOTER_ADDRESS=Unit 311 Campos Rueda Bldg., Urban Avenue, Brgy. Pio Del Pilar, Makati City, 1230
COE_FOOTER_PHONE=(02) 7001-6157
COE_ISSUED_CITY=Makati City, Philippines
COE_SIGNATORY_ROLE=Authorized Company Representative
